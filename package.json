{
  "name": "pix2burn",
  "productName": "Pix2Burn",
  "version": "1.0.0",
  "description": "Préparation d'images pour la gravure laser, G-code et envoi USB vers une machine GRBL",
  "main": "main.js",
  "homepage": "https://github.com/VOTRE-COMPTE/pix2burn",
  "author": "DIDIER"
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.pix2burn.app",
    "productName": "Pix2Burn",
    "artifactName": "Pix2Burn-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "index.html",
      "logo.svg",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.8.8",
    "electron-builder": "^26.18.0"
  }
}
